{
  "name": "playwright-mcp-server",
  "version": "1.0.0",
  "description": "Custom MCP server for browser automation via Playwright (navigate, click, fill, snapshot, screenshot, evaluate)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "playwright-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "postinstall": "playwright install chromium"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
